# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

# Required — Groq API key (free tier: https://console.groq.com)
GROQ_API_KEY=

# Optional — OpenRouter API key for free-tier fallback (https://openrouter.ai)
# See docs/01_ARCHITECTURE.md ADR-008 for details.
OPENROUTER_API_KEY=
